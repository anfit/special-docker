# Local development overrides for docker-compose.yml (copy to .env; never commit .env).
# Production values are not kept in a file in the repo: see docs/AWS_SETUP.md.

# Optional: any 32+ character string. Signs share links, cursors and token hashes; changing it invalidates them.
SPECIAL_APP_KEY=local-development-key-that-is-long-enough-123456

# Used only by `docker compose exec app php scripts/bootstrap-admin.php --username admin`
SPECIAL_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-passphrase
